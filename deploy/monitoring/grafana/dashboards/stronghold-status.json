{
  "uid": "sp-status",
  "title": "卫戍协议 · 服务器状态",
  "description": "卫戍协议服务器的公开运行状况(玩家、游戏服务、主机资源)。数据由 deploy/monitoring 的 collector 从 /healthz?traffic=1 采集。",
  "tags": [
    "stronghold"
  ],
  "timezone": "browser",
  "weekStart": "",
  "editable": false,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
