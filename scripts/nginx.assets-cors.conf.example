# Include these directives INSIDE each existing public-art location that nginx serves directly:
# /assets/, /fonts/, /media/, and the corresponding /_v/<artVersion>/ paths.
# Keep that location's existing alias/root/proxy_pass, cache and security directives.
# Example: include /etc/nginx/snippets/stronghold-assets-cors.conf;
# Node adds these headers itself when nginx forwards art requests to it; do not add a second copy.
# Never include this in the general location / or in API / WebSocket locations.
add_header Access-Control-Allow-Origin "*" always;
add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
add_header Access-Control-Allow-Headers "Range" always;
add_header Access-Control-Expose-Headers "ETag, Content-Length, Content-Range, Accept-Ranges" always;
if ($request_method = OPTIONS) {
    return 204;
}
