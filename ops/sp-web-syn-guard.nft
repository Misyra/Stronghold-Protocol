# ops/sp-web-syn-guard.nft —— 每 IP 的 SYN 速率闸（默认部署配置）
#
# 这份是**规范值**。本表挂在 sp_syn_ban 的永久名单之后（priority - 5），只负责
# 「单 IP 建连接太快」这一件事，不承担已知名单的职责。
#
# 阈值怎么来的：真玩家的 SYN 峰值实测是 0.3/s ≈ 18 次/分钟。页面一次要建十几条连接，
# 浏览器重试又是几条。门槛压到 5 次/分钟那个量级就会开始误伤玩家，而且**不会出现在
# nginx 日志里**（包在 SYN 阶段就没了），表现只是「页面加载怪、要点两次」。
#
# 所以这里定 120/分钟、burst 40、timeout 2m：比真人峰值高 6.7 倍，仍远低于洪水下限；
# burst 40 让一次页面加载的并发连接不再被丢。
#
# 装法见 ops/README.md。改完只盯一个数：
#   nft list table inet sp_web_syn_guard | grep ipv4_syn_drop
# 它的增长速率应归零或显著下降。web_syn4 里会有活跃 IP，那是正常的跟踪项，
# 不代表被丢；只有 ipv4_syn_drop 增长才说明有源超过 120/分钟。
#
# 顺序：sp_syn_ban 在 `priority filter - 6`，本表在 `- 5`，所以已知洪水源
# 先被 perm4 丢掉，根本到不了这里 —— 放宽这条不会把封禁名单放回来。

table inet sp_web_syn_guard {
	set web_syn4 {
		type ipv4_addr
		size 65536
		flags dynamic,timeout
	}

	set web_syn6 {
		type ipv6_addr
		size 65536
		flags dynamic,timeout
	}

	chain input {
		type filter hook input priority filter - 5; policy accept;
		iifname "lo" return
		ct state established,related return
		tcp dport { 80, 443, 3000, 8080 } tcp flags & (syn | ack) == syn jump web_syn
	}

	chain web_syn {
		update @web_syn4 { ip saddr timeout 2m limit rate over 120/minute burst 40 packets } counter drop comment "ipv4_syn_drop"
		update @web_syn6 { ip6 saddr & ffff:ffff:ffff:ffff:: timeout 2m limit rate over 120/minute burst 40 packets } counter drop comment "ipv6_prefix_syn_drop"
		limit rate over 50/second burst 100 packets counter drop comment "global_syn_drop"
		counter comment "web_syn_pass"
	}
}

# 30/分钟 + burst 10 会把真实玩家的重连丢掉（web_syn4 里长期挂着十几个活跃 IP），
# 改成 120/分钟 + burst 40 + timeout 2m 后 ipv4_syn_drop 归零（集合仍跟踪活跃 IP）。
# 再放宽要看 ipv4_syn_drop 的增长速率，不要一次动多个变量。
