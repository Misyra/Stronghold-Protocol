# --- dependencies & generated client libs -------------------------------------------------------
node_modules/
# a local npm cache (npm_config_cache=./.npm-cache, npm ci --cache .npm-cache — GitHub #258)
.npm-cache/
# copied from node_modules by tools/vendor.mjs (postinstall); never commit third-party builds
public/vendor/
public/build/

# --- game assets: (c) Hypergryph / Yostar (see NOTICE.md) ------------------------------------------
# tools/fetch-assets.mjs → public/assets/** (~270 MB) and public/fonts/** (+ fonts.css)
public/assets/*
# This fork tracks the v0.1.3 local-client art for Git-based deployments.
!public/assets/local/
# …except the extracted battlefield scenes (0.2.5): official files no repository stores, so re-ignore them here.
# A maintainer who ran `node tools/setup.mjs --scenes` must not commit public/assets/local/scene/.
/public/assets/local/scene/
public/fonts/
# tools/local-extract/extract.py → public/assets/local/** and this per-machine manifest
# (optional: the client and the tests work without it; custom_docs/operations/DEPLOY.md §6 lists what falls back)
# Battlefield scenes (0.2.5): extracted files live under public/assets/local/scene/ (re-ignored just above).
# Downloaded bundles live in .cache/official-scenes/ (already ignored by .cache/ below).
# This fork tracks the extracted files and the manifest in Git (README 本分支差异): data/local-assets.json is a tracked file here, not an ignored one.
# download caches, upstream tables, ledgers, reports, setup state
.cache/
# Legacy scratch scripts and profiling output belong under .cache/.
/.smoke/
/*.cpuprofile
/*.heapprofile
/*.heapsnapshot
# (optional: the client and the tests work without it; docs/DEPLOY.md §6 lists what falls back)
# Battlefield scenes (0.2.5): extracted files live under public/assets/local/scene/ (already ignored by
# public/assets/ above). Downloaded bundles live in .cache/official-scenes/ (already ignored by .cache/ below).
# The repository never stores those official files.
# tools/local-extract/fx.py → the official battle effects' file list (DESIGN §33; the files under public/assets/local/fx/)
data/local-fx.json
# download caches, upstream tables, ledgers, reports, setup state
.cache/
# a worktree that links these folders instead of holding them: git sees a symlink as a file, which the patterns
# above (trailing slash: directories only) do not match
/node_modules
/public/vendor
/public/assets
/public/fonts
/.cache

# --- Python (optional local-client extraction) ----------------------------------------------------
.venv*/
venv/
__pycache__/
*.py[cod]

# --- content packs (docs/PACKS.md): the pack index for a static host, generated by `node tools/packs.mjs index`
# (the server answers /packs/index.json itself; tools/package.mjs writes this file into the release zips) -----------
packs/index.json

# --- plugins (docs/PLUGINS.md): a server's own plugins and its policy file live in plugins/ and are never committed;
# only the folder's readme, its guide for AI agents (AGENTS.md) and the templates (plugins/_template/, from P1) are tracked — and
# so ship (tools/package.mjs); plugins/_dist/ (packed zips) and plugins/_moved/ (files the studio moved out) stay ignored
plugins/*
!plugins/README.md
!plugins/AGENTS.md
!plugins/_template/

# --- tests & logs ----------------------------------------------------------------------------------
test/e2e/out/
logs/
*.log

# --- per-machine config (scripts/install-service-windows.ps1) ------------------------------------
scripts/service.env.cmd
.env
.env.*
# Hot-loaded server announcement (deployment-specific content).
/announcement.json

# --- local dev notes (session-local remediation plans etc., not for the repo) -----------------------
docs/dev/

# Local development suite artifacts and drafts --------------------------------------------------
/.playwright-mcp/
/custom_docs/operations/NGINX-RELIEF.md
/sp-nginx-optimization-plan.md
/stronghold-resources-9fea2761d427.zip
/test/build-size.test.js
/test/render/context-recovery.browser.test.js
/test/render/impostor-context.test.js
/test/tmp-churn.test.js
/test/ui/announcement.render.test.js
/tools/build-size.mjs

# Working-session scratch: probe scripts, screenshots, one-off notes, the Node compile cache.
/.local/
# The same under the served tree (e.g. a throwaway vite build a probe wrote into public/.state/probe-build).
/public/.state/

# --- OS / editor clutter ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
.claude/

# Optional per-install preload content hashes
/data/asset-hashes.json

# Server checkpoints contain private reconnect tokens; never publish or commit them.
/.state/
*.state.json
*.state.json.lock
*.state.json.*.tmp

# Never track a decoded nickname dictionary.
/server/moderation/lexicon/words.txt
# Retired reversible dictionary encoding and per-deployment encryption keys.
/server/moderation/lexicon/words.b64
*.moderation.key
# tools/sim-check.mjs: the corpus and its Node traces for /dev/sim-check.html
public/dev/simcheck/data/

# Optional MaxMind downloads; Country is already tracked separately.
/geoip/GeoLite2-ASN.mmdb
/geoip/GeoLite2-City.mmdb
