# Keep the build context small and free of machine-specific state (see Dockerfile).
.git
.github
.claude
node_modules
.cache
.smoke
*.cpuprofile
*.heapprofile
*.heapsnapshot
.venv*
**/__pycache__
test
logs
*.log
docs/img
# the image needs only the research JSON tables (server/sim/nodeData.js fallback), not the notes
docs/research/*.md
# Fetched art is mounted/downloaded; the tracked local-client art is included in the build.
public/assets/*
!public/assets/local
# generated from node_modules inside the image
public/vendor
scripts/service.env.cmd
.DS_Store
Thumbs.db
.env
.env.*
.state
*.state.json
*.state.json.lock
*.state.json.*.tmp
