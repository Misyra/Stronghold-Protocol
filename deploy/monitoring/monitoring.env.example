# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to monitoring.env (not committed) next to compose.monitoring.yaml. No secrets here: the Grafana admin password
# lives only in the file GRAFANA_ADMIN_PASSWORD_FILE names (owner 472, mode 0400; README.md §3).

# The address Grafana is served under; a reverse proxy maps /monitor/ to 127.0.0.1:3160 without rewriting the path
# (or keep a local address and reach the admin UI through an SSH tunnel only).
GRAFANA_ROOT_URL=https://example.invalid/monitor/

# The game server's health report with traffic and performance figures. ?traffic=1 is answered only to a loopback /
# private-network client (server/http/routes.js) — collector must reach the server from this machine or the LAN.
MONITOR_HEALTHZ_URL=http://127.0.0.1:3000/healthz?traffic=1
# (placeholder address: use the game server's actual address and port)

# Host path of the Grafana admin password file (bind-mounted read-only into the Grafana container).
GRAFANA_ADMIN_PASSWORD_FILE=/etc/sp-monitor/grafana-admin-password

# Pinned images (README.md lists their digests). Change them together with a re-test.
NODE_IMAGE=node:24.22.0-alpine3.24
COLLECTOR_IMAGE=sp-monitor-collector:local
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
GRAFANA_IMAGE=grafana/grafana:13.2.4
