{
  // First typecheck slice (npm run typecheck). strict stays off until a folder is clean.
  // tsc does not load this file unless invoked with -p jsconfig.json.
  // Widen one path at a time: see types/README.md.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    // The shared slice intentionally loads no DOM/Node lib (see shared/plugins/scriptLoad.js). The isomorphic
    // globals shared/ reads — URL, URLSearchParams, AbortSignal — come from types/shared-globals.d.ts instead.
    "lib": ["ES2022"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/**/*.js",
    "server/sim/rng.js",
    "server/sim/detmath.js",
    "server/sim/dir.js",
    "server/sim/constants.js",
    "types/**/*.js",
    "types/*.d.ts"
  ],
  "exclude": [
    "shared/protocol.js",
    "shared/bandBonds.js"
  ]
}
