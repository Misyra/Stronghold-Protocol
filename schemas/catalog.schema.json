{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "A community plugin catalogue",
  "description": "A list of plugins someone else publishes (docs/PLUGINS.md §17, docs/plugin-catalog.example.json). This project does not host the files. Accepted here means shared/plugins/catalog.js readCatalog finds neither a problem nor a warning, except two things only the check sees: the same id twice (uniqueItems compares the whole entry, not the id) and an app string that is not a version range. Addresses are https with a dotted host and no user or password. bytes, when present, is at most 200 MB (209715200).",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog", "name", "plugins"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 200 },
    "catalog": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^https:\\/\\/(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:\\/[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "class", "url", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "class": { "enum": ["lang", "cosmetic", "content", "script", "ui", "trusted"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 209715200 },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authors": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 80 },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          ]
        },
        "app": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
