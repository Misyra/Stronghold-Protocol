    {
      "id": 15,
      "type": "timeseries",
      "title": "主线程事件循环延迟",
      "description": "每 10 秒窗口内，服务器主线程处理排队工作的等待时间（p99 与最大值）。约 20 ms 是测量下限；长时间高于 100 ms 时操作会明显变慢。",
      "datasource": {
        "type": "prometheus",
        "uid": "sp-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "sp-prometheus"
          },
          "expr": "sp_event_loop_delay_seconds{job=\"collector\",stat=\"p99\"}",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "sp-prometheus"
          },
          "expr": "sp_event_loop_delay_seconds{job=\"collector\",stat=\"max\"}",
          "legendFormat": "最大",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
